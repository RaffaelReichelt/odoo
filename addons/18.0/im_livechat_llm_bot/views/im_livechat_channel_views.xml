<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="im_livechat_channel_view_form_llm_bot" model="ir.ui.view">
        <field name="name">im.livechat.channel.form.llm.bot</field>
        <field name="model">im_livechat.channel</field>
        <field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='options']" position="after">
                <page string="KI-Bot" name="llm_bot">
                    <group>
                        <field name="llm_assistant_id"/>
                    </group>
                    <p class="text-muted">
                        Wenn ein KI-Assistent ausgewaehlt ist, beantwortet er eingehende
                        Besuchernachrichten automatisch, solange kein interner Operator im
                        Gespraech geantwortet hat und kein Skript-Chatbot aktiv ist. Assistenten
                        werden unter KI &gt; Assistenten konfiguriert (Provider, Modell, Prompt).
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
