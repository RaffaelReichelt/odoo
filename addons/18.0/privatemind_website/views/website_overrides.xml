<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Website-Anpassungen am Standard-Frontend (Header-Toolbar, Produktseite).
        Bewusst als View-Overrides im Modul statt per Website-Builder, damit sie in Git
        liegen und bei einer frischen Installation reproduzierbar sind.
    -->

    <!--
        Toolbar im Header: Odoo-Demo-Kontaktdaten (+1 555-555-5556, info@yourcompany.example.com)
        durch die Daten des Firmeneintrags (res_company) ersetzen. Die Varianten 'sentence'
        und 'list' enthalten keine Kontaktdaten und bleiben unveraendert.
    -->
    <template id="header_text_element_phone" inherit_id="website.header_text_element" name="Header Toolbar Kontaktdaten aus Firmeneintrag">
        <xpath expr="//li/t[@t-elif=&quot;_txt_elt_content == 'phone_mail'&quot;]" position="replace">
            <t t-elif="_txt_elt_content == 'phone_mail'">
                <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                    <a t-attf-href="tel:#{res_company.phone}" class="nav-link o_nav-link_secondary">
                        <small>
                            <i class="fa fa-1x fa-fw fa-phone me-1"/>
                            <span class="o_force_ltr" t-out="res_company.phone"/>
                        </small>
                    </a>
                    <a t-attf-href="mailto:#{res_company.email}" class="nav-link o_nav-link_secondary">
                        <small>
                            <i class="fa fa-1x fa-fw fa-envelope me-1"/>
                            <t t-out="res_company.email"/>
                        </small>
                    </a>
                </div>
            </t>
        </xpath>
        <xpath expr="//li/t[@t-elif=&quot;_txt_elt_content == 'mail'&quot;]" position="replace">
            <t t-elif="_txt_elt_content == 'mail'">
                <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                    <a t-attf-href="mailto:#{res_company.email}" class="nav-link o_nav-link_secondary">
                        <small><i class="fa fa-1x fa-fw fa-envelope me-1"/> <t t-out="res_company.email"/></small>
                    </a>
                </div>
            </t>
        </xpath>
        <xpath expr="//li/t[@t-elif=&quot;_txt_elt_content == 'mail_stretched'&quot;]" position="replace">
            <t t-elif="_txt_elt_content == 'mail_stretched'">
                <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                    <a t-attf-href="tel:#{res_company.phone}" class="nav-link o_nav-link_secondary p-2 o_navlink_background_hover d-flex align-items-center h-100 text-reset">
                        <i class="fa fa-1x fa-fw fa-phone me-1"/>
                        <span class="o_force_ltr"><small t-out="res_company.phone"/></span>
                    </a>
                </div>
            </t>
        </xpath>
        <xpath expr="//li/t[@t-else]" position="replace">
            <t t-else="">
                <div t-attf-class="s_text_block #{_div_class}" data-name="Text">
                    <a t-attf-href="tel:#{res_company.phone}" class="nav-link o_nav-link_secondary p-2">
                        <i class="fa fa-1x fa-fw fa-phone me-1"/>
                        <span class="o_force_ltr"><small t-out="res_company.phone"/></span>
                    </a>
                </div>
            </t>
        </xpath>
    </template>

    <!--
        Hauptnavigation (ul.top_menu) im Desktop-Header ausblenden. navbar_nav wird fuer
        Desktop und Mobile genutzt; das Hamburger-Menue (is_mobile) bleibt erhalten.
    -->
    <template id="navbar_nav_mobile_only" inherit_id="website.navbar_nav" name="Hauptnavigation nur mobil">
        <xpath expr="//ul" position="attributes">
            <attribute name="t-if">is_mobile</attribute>
        </xpath>
    </template>

    <!--
        Ohne Hauptnavigation soll die rechte Header-Leiste am rechten Rand bleiben. Der Desktop-Header
        laeuft ueber die volle Fensterbreite (container-fluid): Logo links am Rand, Leiste rechts.
    -->
    <template id="header_default_end_aligned" inherit_id="website.template_header_default" name="Header volle Breite, Leiste rechts">
        <xpath expr="//div[@id='o_main_nav']" position="attributes">
            <attribute name="class" remove="container" add="container-fluid px-4" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='o_main_nav']/ul[hasclass('justify-content-end')]" position="attributes">
            <attribute name="class" add="ms-auto" separator=" "/>
        </xpath>
    </template>

    <!--
        Standard-Kontaktseite /contactus und Danke-Seite: Demo-Block ("My Company",
        3575 Fake Buena Vista Avenue, +1 555-555-5556, info@yourcompany.example.com)
        durch die Daten des Firmeneintrags ersetzen.
    -->
    <template id="contactus_company_data" inherit_id="website.contactus" name="Kontaktseite mit Firmendaten">
        <xpath expr="//ul[li/i[hasclass('fa-map-marker')]]/preceding-sibling::h5[1]" position="replace">
            <h5 t-out="res_company.name"/>
        </xpath>
        <xpath expr="//ul[li/i[hasclass('fa-map-marker')]]" position="replace">
            <ul class="list-unstyled mb-0 ps-2">
                <li><i class="fa fa-map-marker fa-fw me-2"/><span class="o_force_ltr"><t t-out="res_company.street"/><t t-if="res_company.street2">, <t t-out="res_company.street2"/></t>, <t t-out="res_company.zip"/> <t t-out="res_company.city"/></span></li>
                <li><i class="fa fa-phone fa-fw me-2"/><span class="o_force_ltr"><a t-attf-href="tel:#{res_company.phone}" t-out="res_company.phone"/></span></li>
                <li><i class="fa fa-1x fa-fw fa-envelope me-2"/><span><a t-attf-href="mailto:#{res_company.email}" t-out="res_company.email"/></span></li>
            </ul>
        </xpath>
    </template>

    <template id="contactus_thanks_company_data" inherit_id="website.contactus_thanks_ir_ui_view" name="Danke-Seite mit Firmendaten">
        <xpath expr="//ul[li/i[hasclass('fa-map-marker')]]/preceding-sibling::h5[1]" position="replace">
            <h5 t-out="res_company.name"/>
        </xpath>
        <xpath expr="//ul[li/i[hasclass('fa-map-marker')]]" position="replace">
            <ul class="list-unstyled mb-0 ps-2">
                <li><i class="fa fa-map-marker fa-fw me-2"/><span class="o_force_ltr"><t t-out="res_company.street"/><t t-if="res_company.street2">, <t t-out="res_company.street2"/></t>, <t t-out="res_company.zip"/> <t t-out="res_company.city"/></span></li>
                <li><i class="fa fa-phone fa-fw me-2"/><span class="o_force_ltr"><a t-attf-href="tel:#{res_company.phone}" t-out="res_company.phone"/></span></li>
                <li><i class="fa fa-1x fa-fw fa-envelope me-2"/><span><a t-attf-href="mailto:#{res_company.email}" t-out="res_company.email"/></span></li>
            </ul>
        </xpath>
    </template>

    <!-- Breadcrumbs auf der Produktseite entfernen; der Link ueber das Logo reicht. -->
    <template id="product_no_breadcrumb" inherit_id="website_sale.product" name="Produktseite ohne Breadcrumbs">
        <xpath expr="//ol[hasclass('o_wsale_breadcrumb')]" position="replace"/>
    </template>
</odoo>
